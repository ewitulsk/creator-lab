# Copy to backend/.env (or run `uv run creator-lab setup` in backend/, which does it
# and generates SECRET_KEY and RUNNER_TOKEN). backend/.env is gitignored. Never commit it.

# Admin login. ADMIN_PASSWORD is read once, on first start, and stored as a hash;
# after that, change the password in Settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Session signing key. `creator-lab setup` generates one.
SECRET_KEY=generate-with-setup

# YouTube Data API v3 key (Google Cloud console > APIs & Services > Credentials).
YOUTUBE_API_KEY=paste-your-key-here

# Where the database, media and analyzer outputs live.
DATA_ROOT=D:\VideoAnalysis\data

# Shared secret runners send as `Authorization: Bearer ...`. `creator-lab setup` generates one.
RUNNER_TOKEN=generate-with-setup

# BrainThing checkout with the TRIBE v2 venv (used by runners/tribe).
BRAINTHING_DIR=D:\VideoAnalysis\BrainThing

# Download resolution cap. 4K is never stored: values above 1080 are clamped. 720 is fine too.
MAX_VIDEO_HEIGHT=1080

# YouTube owner sync (OAuth). See docs/youtube-oauth.md. Leave as-is until you set it up.
GOOGLE_OAUTH_CLIENT_ID=paste-your-key-here
GOOGLE_OAUTH_CLIENT_SECRET=paste-your-key-here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5050/api/youtube/oauth/callback
